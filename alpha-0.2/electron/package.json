{
  "name": "trzewia",
  "productName": "Trzewia",
  "version": "0.2.1",
  "description": "Trzewia — Alpha 0.2",
  "author": "kanalpatryk-netizen",
  "private": true,
  "main": "main.js",
  "desktopName": "trzewia.desktop",
  "scripts": {
    "exe": "node budowa.mjs",
    "linux": "node budowa.mjs linux"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "pl.trzewia.alpha02",
    "productName": "Trzewia",
    "copyright": "Trzewia",
    "files": ["main.js", "preload.js", "gra/**"],
    "electronLanguages": ["pl", "en-US"],
    "compression": "store",
    "directories": { "output": "dist", "buildResources": "zasoby" },
    "afterPack": "./po-spakowaniu.cjs",
    "publish": null,
    "toolsets": { "appimage": "1.0.3" },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "zasoby/ikona.ico",
      "signAndEditExecutable": false
    },
    "portable": { "artifactName": "Trzewia-alpha-0.2.exe", "unpackDirName": true },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "zasoby/ikona.png",
      "executableName": "trzewia",
      "category": "Game",
      "synopsis": "Trzewia — Alpha 0.2",
      "syncDesktopName": true
    },
    "appImage": { "artifactName": "Trzewia-alpha-0.2.AppImage", "compression": "zstd" }
  }
}
