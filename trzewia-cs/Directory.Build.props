<Project>
  <!-- Wspólne dla wszystkich projektów Trzewi w C#. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- Liczby zawsze z kropką (jak toFixed w JS) — polski Windows pisałby „12,5” w liczniku i w zapisie. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <Product>Trzewia</Product>
    <Company>Trzewia</Company>
    <Copyright>Trzewia</Copyright>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Warstwy przenośne (decyzja użytkownika 10.11: „żeby potem wszystko łatwo można było przenieść pod jakiś silnik,
    np. Unity albo Godot”): .NET Standard 2.1 i C# 9 — to przyjmuje Unity (także z IL2CPP) i Godot 4 bez zmian,
    jako gotowe DLL albo jako pliki źródłowe. Żadnych typów SDL ani okna; Skia tylko w Trzewia.Skia.
    Zasady pisania tych warstw: trzewia-cs/PLAN.md, punkt 3.0.
  -->
  <PropertyGroup Condition="'$(Przenosny)' == 'true'">
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Przenosny)' != 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
