<Project>
  <!-- Wspólne dla wszystkich projektów Trzewi w C#. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- Liczby zawsze z kropką (jak toFixed w JS) — polski Windows pisałby „12,5” w liczniku i w zapisie. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <Product>Trzewia</Product>
    <Company>Trzewia</Company>
    <Copyright>Trzewia</Copyright>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Warstwy przenośne (Trzewia.Symulacja, Trzewia.Gra, Trzewia.Skia) same ustawiają netstandard2.1 i C# 9 (decyzja
    użytkownika 10.11: „żeby potem wszystko łatwo można było przenieść pod jakiś silnik, np. Unity albo Godot”);
    gospodarz i testy — .NET 10 i najnowszy C#. Zasady pisania warstw przenośnych: PLAN.md, punkt 3.0.
  -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
  </PropertyGroup>
</Project>
