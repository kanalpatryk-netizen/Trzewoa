<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Warstwa 1 (przenośna): symulacja, nastawy, ryty, bot, RNG, zgodność z JavaScriptem. Bez grafiki, dźwięku i bibliotek —
    testy chodzą bez okna i karty, a w Unity/Godocie ta sama biblioteka liczy grę bit w bit tak samo.
  -->
  <PropertyGroup>
    <!-- warstwa przenośna: .NET Standard 2.1 i C# 9 (Unity, Godot) — PLAN.md, punkt 3.0 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Trzewia</RootNamespace>
    <AssemblyName>Trzewia.Symulacja</AssemblyName>
  </PropertyGroup>
</Project>
