<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Warstwa 2 (przenośna): wszystko, co gracz widzi i słyszy — rysunek (jak src/render), ekrany i wejście (src/app),
    interfejs, atlas, przerywniki, synteza dźwięku, ustawienia, klawisze, licznik F3. Rysuje wyłącznie przez IPlotno
    (polecenia Canvas 2D), pliki czyta i zapisuje przez Gospodarz — nie zna Skii, SDL ani systemu plików gry.
  -->
  <PropertyGroup>
    <!-- warstwa przenośna: .NET Standard 2.1 i C# 9 (Unity, Godot) — PLAN.md, punkt 3.0 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Trzewia</RootNamespace>
    <AssemblyName>Trzewia.Gra</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trzewia.Symulacja\Trzewia.Symulacja.csproj" />
  </ItemGroup>
</Project>
